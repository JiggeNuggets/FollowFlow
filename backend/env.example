# FollowFlow — Environment Variables
# Copy to .env and fill in your values.
# NEVER commit .env to Git.
#
# On Render: add these in Dashboard → Environment → Add Environment Variable

# ── Auth ──────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string

# ── Database ──────────────────────────────────────────────────
# Default: SQLite (no setup needed). Change to Postgres/MySQL URL later.
DATABASE_URL=sqlite:///./followflow.db
# Postgres example: postgresql://user:pass@host/dbname
# MySQL example:    mysql+pymysql://user:pass@host/dbname

# ── OpenAI (optional) ─────────────────────────────────────────
# Leave blank → static email templates are used instead
OPENAI_API_KEY=

# ── Gmail OAuth2 (optional) ───────────────────────────────────
# Get from: console.cloud.google.com → APIs & Services → Credentials
# Leave blank → Gmail features show "not configured" to the user
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-backend.onrender.com/api/gmail/callback

# ── PayPal (optional) ─────────────────────────────────────────
# Get from: developer.paypal.com → My Apps → REST API Apps
# Sandbox credentials for testing, live credentials for production
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# "sandbox" or "live"
PAYPAL_MODE=sandbox

# ── Follow-up schedule ────────────────────────────────────────
FOLLOWUP_DAY_1=3
FOLLOWUP_DAY_2=5
FOLLOWUP_DAY_3=7
